{
  "name": "s16-cicd-demo",
  "version": "1.0.0",
  "description": "Session 16 CI/CD demo app (Express) - Dhruv Yadav 24BCS10204",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --ci --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "jest": "^30.0.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
