{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPlainHttp",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::s18-notes-kushal", "arn:aws:s3:::s18-notes-kushal/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "AllowReadToDevGroupRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::000000000000:role/s18-ec2-app-role" },
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::s18-notes-kushal/*"
    }
  ]
}
