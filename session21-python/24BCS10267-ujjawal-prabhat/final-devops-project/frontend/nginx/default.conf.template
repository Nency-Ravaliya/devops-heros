# Rendered by the nginx image entrypoint (envsubst) at start-up.
# BACKEND_URL: docker compose -> http://backend:8000, Helm -> the backend Service FQDN.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Resolve the backend per request (nameserver from /etc/resolv.conf), so nginx
  # still starts when the backend name is not resolvable yet.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $backend ${BACKEND_URL};

  location / {
    try_files $uri /index.html;
  }

  location /api/ {
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
