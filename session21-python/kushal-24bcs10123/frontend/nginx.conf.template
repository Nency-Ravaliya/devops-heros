# Served by nginx-unprivileged (listens on 8080, runs as uid 101).
# BACKEND_URL is filled in by the image's envsubst step at container start:
#   compose     -> http://backend:8000
#   kubernetes  -> http://studytrack-backend:8000  (the Ingress also routes /api directly)
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
